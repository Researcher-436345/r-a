# Copy to .env and fill in the values. Real environment variables (shell export,
# docker -e) override anything set here.

# --- required ---
OPENAI_API_KEY=sk-your-key-here
ARTICLE_SERVICE_URL=http://localhost:9100
CHAT_SERVICE_URL=http://localhost:9100

# --- optional (defaults shown) ---
PORT=8080
OPENAI_MODEL=gpt-4o
# OPENAI_BASE_URL=https://your-openai-compatible-gateway/v1
LLM_MAX_TOKENS=1024
LLM_TEMPERATURE=0.2
REQUEST_TIMEOUT=60s
UPSTREAM_TIMEOUT=10s
