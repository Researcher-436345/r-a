# Значения по умолчанию находятся в settings.py.
# Здесь нужны секреты и настройки, которые отличаются от общих значений.
# Docker Compose передаёт этот файл сервисам; go run и Python читают env процесса.

# Прямые API: ключи разных провайдеров не наследуются друг от друга.
OPENAI_API_KEY=
OPENROUTER_API_KEY=

# По умолчанию OpenAI использует gpt-6.1-terra с reasoning medium; deep research — max.
# Одна LLM_MODEL используется чатом, обзором, веб-поиском и deep research.
# LLM_MODEL=gpt-6.1-terra
# SUMMARY_LLM_MODEL=
# WEBSEARCH_LLM_MODEL=
# WEBSEARCH_DEEP_LLM_MODEL=
# Разрешённые модели в переключателе чата: id|Название,id2|Название2.
# LLM_MODELS=

# Прямые адреса уже заданы в settings.py. При необходимости переопределить:
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Перевод и описания ленты используют прежнюю Gemma через прямой OpenRouter.
# TRANSLATION_LLM_MODEL=google/gemma-4-26b-a4b-it
# TRANSLATION_BASE_URL=https://openrouter.ai/api/v1
# TRANSLATION_API_KEY=
# FEED_TRANSLATION_MODEL=google/gemma-4-26b-a4b-it
# FEED_TRANSLATION_BASE_URL=https://openrouter.ai/api/v1
# FEED_TRANSLATION_API_KEY=

# Отдельные бюджеты обычного поиска и глубокого исследования.
# WEBSEARCH_REASONING_EFFORT=medium
# WEBSEARCH_DEEP_REASONING_EFFORT=max
# WEBSEARCH_MAX_TOOL_CALLS=6
# WEBSEARCH_DEEP_MAX_TOOL_CALLS=40
# WEBSEARCH_MAX_OUTPUT_TOKENS=16000
# WEBSEARCH_DEEP_MAX_OUTPUT_TOKENS=64000
# WEBSEARCH_TIMEOUT_SECONDS=180
# WEBSEARCH_DEEP_TIMEOUT_SECONDS=1800
# WEBSEARCH_DOMAINS=arxiv.org,doi.org,semanticscholar.org,aclanthology.org,proceedings.mlr.press,openaccess.thecvf.com,proceedings.neurips.cc,papers.nips.cc,ojs.aaai.org
# Пустая строка WEBSEARCH_DOMAINS= отключает ограничение доменов.

# Общие лимиты и рассуждения модели.
# LLM_REASONING_EFFORT=medium
# CHAT_REASONING_EFFORT=medium
# SUMMARY_REASONING_EFFORT=medium
# LLM_CONTEXT_TOKENS=120000
# LLM_REPLY_RESERVE=4000
# CHAT_RECENT_KEEP=8
# LLM_MAX_OUTPUT_TOKENS=16000
# SUMMARY_MAX_OUTPUT_TOKENS=32000
# SUMMARY_REPLY_RESERVE=9000

# Авторизация и почта. Для внешнего окружения задать собственные секреты.
JWT_SECRET=dev-only-change-me-in-production
INTERNAL_TOKEN=
# FRONTEND_URL=http://localhost:5180
# COOKIE_SECURE=false
# SMTP_HOST=localhost
# SMTP_PORT=1025
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=researcher@localhost
# MAIL_ENABLED=false
# EMAIL_VERIFICATION_ENABLED=true

# Локальные подключения. Docker Compose задаёт внутренние адреса отдельно.
# DATABASE_URL=postgresql://researcher:researcher@localhost:5433/researcher
# REDIS_URL=redis://localhost:6379/0
# S3_ENDPOINT_URL=http://localhost:9000
# S3_PUBLIC_ENDPOINT_URL=http://localhost:9000
# S3_ACCESS_KEY=minioadmin
# S3_SECRET_KEY=minioadmin
# S3_BUCKET=papers

# PARSER_ENGINE=pymupdf
# PARSER_OCR=auto
# PARSER_MAX_UPLOAD_BYTES=53477376
# CITATIONS_ENABLED=true
# OPENALEX_MAILTO=researcher@localhost
# SEMANTIC_SCHOLAR_API_KEY=

# Параметры сборки фронтенда переопределяются также в frontend/.env.
# VITE_API_URL=/api
# DEV_API_TARGET=http://77.91.114.154:8081
# DEV_PORT=5180
# VITE_ENABLE_ANALYTICS=true
