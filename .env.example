# Copy to .env before docker compose up:
#   cp .env.example .env

ENVIRONMENT=local
APP_NAME=researcher-api

DATABASE_URL=postgres://researcher:researcher@localhost:5433/researcher
REDIS_URL=redis://localhost:6379/0

# Auth (обязательно смени JWT_SECRET вне local)
JWT_SECRET=dev-only-change-me-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=14

S3_ENDPOINT_URL=http://localhost:9002
S3_PUBLIC_ENDPOINT_URL=http://localhost:9002
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=papers

# LLM / перевод — ProxyAPI, OpenRouter или другой OpenAI-compatible API
LLM_PROVIDER=openai_compatible
LLM_BASE_URL=https://openai.api.proxyapi.ru/v1
LLM_API_KEY=
LLM_MODEL=openai/gpt-4o-mini
# Comma list for the chat model picker: id|Label
# LLM_MODELS=openai/gpt-4o-mini|GPT-4o mini,openai/gpt-4o|GPT-4o,deepseek/deepseek-chat|DeepSeek
LLM_TIMEOUT_SECONDS=60

# Gateway upstreams (в Docker задаются в compose; для локального go run:)
# IDENTITY_URL=http://localhost:8101
# CATALOG_URL=http://localhost:8102
# LIBRARY_URL=http://localhost:8103
# ANNOTATIONS_URL=http://localhost:8104
# ASSISTANT_URL=http://localhost:8105
# FEED_URL=http://localhost:8106
# SEARCH_API_URL=http://localhost:8107

# Agentic web search through OpenRouter server tools
WEBSEARCH_SERVICE_URL=http://localhost:8092
WEBSEARCH_LLM_BASE_URL=https://api.proxyapi.ru/openrouter/v1
WEBSEARCH_LLM_API_KEY=
WEBSEARCH_LLM_MODEL=deepseek/deepseek-v4-flash
WEBSEARCH_DEEP_LLM_MODEL=perplexity/sonar-deep-research
WEBSEARCH_TIMEOUT_SECONDS=180
WEBSEARCH_DEEP_TIMEOUT_SECONDS=600
# Автоматический поиск новых событий. По умолчанию выключен, чтобы не расходовать API.
EVENT_DISCOVERY_ENABLED=false
# Shared by Go -> Python internal calls. Set a non-empty value outside local dev.
INTERNAL_TOKEN=

# Сервис перевода (в Docker TRANSLATION_SERVICE_URL задаётся автоматически)
TRANSLATION_SERVICE_URL=http://localhost:8090
TRANSLATION_HTTP_ADDR=:8090
TRANSLATION_LLM_MODEL=google/gemma-4-26b-a4b-it
TRANSLATION_MAX_CHARS=5000
TRANSLATION_MAX_CONCURRENT=8

# PDF parser (Docling + PyMuPDF fallback)
PARSER_SERVICE_URL=http://localhost:8091
PARSER_ENGINE=pymupdf
PARSER_OCR=auto
PARSER_TIMEOUT_SECONDS=180
# For Docling (heavy image): rebuild parser with
#   docker compose build --build-arg PARSER_WITH_DOCLING=1 parser
# or pip install -r requirements-docling.txt inside the image, then PARSER_ENGINE=auto

# Chat context budget (full paper stuffing + rolling history summary)
LLM_CONTEXT_TOKENS=120000
LLM_REPLY_RESERVE=4000
CHAT_RECENT_KEEP=8

# Прямой OpenRouter:
# LLM_BASE_URL=https://openrouter.ai/api/v1
# LLM_MODEL=openai/gpt-4o-mini
# LLM_HTTP_REFERER=http://localhost:5173
# LLM_APP_TITLE=Researcher

# OpenRouter через ProxyAPI:
# LLM_BASE_URL=https://api.proxyapi.ru/openrouter/v1
# LLM_MODEL=mistralai/mistral-medium-3.1

# --- Citations (лента / карточки) ---
# Сейчас: OpenAlex без ключа (достаточно mailto).
CITATIONS_ENABLED=true
OPENALEX_MAILTO=researcher@localhost
#
# TODO(потом): зарегистрировать и вставить ключи для более полного покрытия,
# особенно свежих arXiv (OpenAlex часто отстаёт / 404 на brand-new).
# Semantic Scholar — лучший lookup по ARXIV:id + batch:
#   https://www.semanticscholar.org/product/api#api-key-form
# SEMANTIC_SCHOLAR_API_KEY=
#
# OpenAlex тоже можно усилить ключом (не обязательно для бейзлайна):
#   https://openalex.org/settings/api
# OPENALEX_API_KEY=

# Frontend
VITE_API_URL=http://localhost:8080
