{
	# Порт 80 обслуживает существующий фронтенд. Проверка сертификата идёт через 443.
	auto_https disable_redirects
	default_sni {$GRAFANA_PUBLIC_HOST}
}

https://{$GRAFANA_PUBLIC_HOST} {
	tls {
		issuer acme {
			dir https://acme-v02.api.letsencrypt.org/directory
			profile shortlived
			disable_http_challenge
		}
	}

	redir /grafana /grafana/ 308

	handle /grafana/metrics* {
		respond "Not found" 404
	}

	handle /grafana/* {
		reverse_proxy grafana:3000
	}

	# API на том же HTTPS origin; префикс /api не передаём gateway.
	handle_path /api/* {
		reverse_proxy gateway:8000 {
			flush_interval -1
		}
	}

	# Основной адрес и SPA-маршруты принадлежат Odyssey.
	handle {
		reverse_proxy frontend:80
	}
}
