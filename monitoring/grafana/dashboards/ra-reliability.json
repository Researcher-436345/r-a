  "panels": [
    {
      "id": 1,
      "type": "text",
      "title": "Как читать показатели",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 4
      },
      "options": {
        "mode": "markdown",
        "content": "Итог SSE определяется по done/error, а не по HTTP 200. Время до первого содержимого исключает сообщения прогресса. Ошибки генерации, отмены и ожидание готовности обзора разделены. Проверки blackbox здесь выполняются с того же VPS; для обнаружения потери всего сервера нужна независимая внешняя проверка."
      }
    },
    {
      "id": 2,
      "title": "Доступность сценариев",
      "description": "",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "probe_success{job=\"probes\"}",
          "legendFormat": "{{instance}}",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "instant": false,
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "Нет данных",
          "decimals": 2,
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
