  "panels": [
    {
      "id": 1,
      "type": "text",
      "title": "Как читать показатели",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 4
      },
      "options": {
        "mode": "markdown",
        "content": "Стоимость — только суммы, явно возвращённые провайдером; это мониторинг наблюдаемых расходов, а не сверка счёта. Пропущенные usage/cost не превращаются в бесплатные запросы: покрытие показывается отдельно. Первые короткие интервалы и перезапуски ограничивают точность increase(). Тексты запросов и ответов не экспортируются."
      }
    },
    {
      "id": 2,
      "title": "Сообщённые расходы за выбранный период",
      "description": "",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(increase(ra_llm_reported_cost_dollars_total[$__range]))",
          "legendFormat": "",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "noValue": "Нет данных",
          "decimals": 2,
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": false
        },
        "textMode": "auto",
        "colorMode": "value"
      }
    },
