  "panels": [
    {
      "id": 1,
      "type": "text",
      "title": "Как читать показатели",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 4
      },
      "options": {
        "mode": "markdown",
        "content": "Продуктовые показатели относятся к авторизованным пользователям и пересчитываются раз в 15 минут. Окна DAU/WAU/MAU — последние 1/7/30 суток. Retention и BRR считаются по зрелым когортам; нулевой знаменатель означает **недостаточно данных**. История начинается с подключения мониторинга."
      }
    },
    {
      "id": 2,
      "title": "Пользователи с результатом за 7 дней",
      "description": "",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max(ra_product_value_users{window=\"7d\"})",
          "legendFormat": "",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "Нет данных",
          "decimals": 2,
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": false
        },
        "textMode": "auto",
