VITE_API_URL=http://localhost:8080

# Show the optional active-sessions screen (requires a frontend rebuild).
VITE_ENABLE_ACTIVE_SESSIONS=false

# Show the landing page at entry and /welcome (requires a frontend rebuild).
VITE_ENABLE_LANDING=false

# Optionally require login before entering any application page.
VITE_REQUIRE_LOGIN_ON_ENTRY=false
